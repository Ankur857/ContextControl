# ContextControl Backend Configuration
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development

# Google Gemini API Configuration (Phase 5)
# Obtain your key from https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# PostgreSQL / Supabase with pgvector (Phase 7)
# Leave empty to keep semantic search unconfigured (manual context selection remains fully active)
# Example: postgresql://postgres:password@localhost:5432/contextcontrol
DATABASE_URL=

# Semantic Search & Embedding Provider (Phase 7)
# Providers: 'gemini' (requires GEMINI_API_KEY) or 'mock' (deterministic for local testing)
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIMENSION=768

# Test / Fallback vector store for unit tests or offline local development
ALLOW_TEST_VECTOR_STORE=false
